<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.thynanami.idea.typst</id>
    <name>Typst</name>
    <vendor>Nanami Nakano</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.externalSystem</depends>
    <depends>com.intellij.modules.jcef</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <depends optional="true" config-file="typst-grazie.xml">tanvd.grazi</depends>

    <extensions defaultExtensionNs="com.intellij">
        <lang.parserDefinition language="Typst"
                               implementationClass="dev.thynanami.idea.typst.psi.TypstParserDefinition"/>
        <lang.parserDefinition language="TypstCode"
                               implementationClass="dev.thynanami.idea.typst.psi.TypstCodeParserDefinition"/>
        <lang.commenter language="Typst"
                        implementationClass="dev.thynanami.idea.typst.editor.TypstCommenter"/>
        <lang.commenter language="TypstCode"
                        implementationClass="dev.thynanami.idea.typst.editor.TypstCommenter"/>
        <fileEditorProvider implementation="dev.thynanami.idea.typst.editor.TypstEditorProvider"/>
        <configurationType implementation="dev.thynanami.idea.typst.run.TypstRunConfigurationType"/>
        <runConfigurationProducer id="typst.compile"
                                  implementation="dev.thynanami.idea.typst.run.TypstCompileConfigurationProducer"/>
        <runConfigurationProducer order="after typst.compile"
                                  implementation="dev.thynanami.idea.typst.run.TypstWatchConfigurationProducer"/>
        <runLineMarkerContributor language="Typst"
                                  implementationClass="dev.thynanami.idea.typst.run.TypstRunLineMarkerContributor"/>
        <typedHandler implementation="dev.thynanami.idea.typst.editor.TypstTypedHandler" order="first"/>
        <backspaceHandlerDelegate implementation="dev.thynanami.idea.typst.editor.TypstBackspaceHandler" order="first"/>
        <enterHandlerDelegate implementation="dev.thynanami.idea.typst.editor.TypstEnterHandler" order="first"/>
        <toolWindow id="Typst Outline"
                    anchor="right"
                    icon="/icons/typstFiletypeIcon.svg"
                    factoryClass="dev.thynanami.idea.typst.lsp.outline.TypstOutlineToolWindowFactory"/>
        <statusBarWidgetFactory id="TypstWordCount"
                                implementation="dev.thynanami.idea.typst.lsp.status.TypstWordCountWidgetFactory"
                                order="after Position"/>
        <statusBarWidgetFactory id="TypstCharacterCount"
                                implementation="dev.thynanami.idea.typst.lsp.status.TypstCharacterCountWidgetFactory"
                                order="after TypstWordCount"/>
        <statusBarWidgetFactory id="TypstPageCount"
                                implementation="dev.thynanami.idea.typst.lsp.status.TypstPageCountWidgetFactory"
                                order="after TypstCharacterCount"/>
        <statusBarWidgetFactory id="TypstCompiledFile"
                                implementation="dev.thynanami.idea.typst.lsp.status.TypstCompiledFileWidgetFactory"
                                order="after TypstPageCount"/>
        <statusBarWidgetFactory id="TypstCompilationStatus"
                                implementation="dev.thynanami.idea.typst.lsp.status.TypstCompilationStatusWidgetFactory"
                                order="after TypstCompiledFile"/>
        <fileType
                name="Typst"
                implementationClass="dev.thynanami.idea.typst.TypstFileType"
                fieldName="INSTANCE"
                language="Typst"
                extensions="typ"/>
        <fileType
                name="Typst (Code Mode)"
                implementationClass="dev.thynanami.idea.typst.TypstCodeFileType"
                fieldName="INSTANCE"
                language="TypstCode"
                extensions="typc"/>
        <applicationConfigurable id="dev.thynanami.idea.typst.settings"
                                 parentId="language"
                                 instance="dev.thynanami.idea.typst.config.TypstSettingsConfigurable"
                                 displayName="Typst"/>
        <projectConfigurable id="dev.thynanami.idea.typst.typm.settings"
                             parentId="dev.thynanami.idea.typst.settings"
                             instance="dev.thynanami.idea.typst.typm.TypmSettingsConfigurable"
                             displayName="Typm"
                             nonDefaultProject="true"/>
        <postStartupActivity implementation="dev.thynanami.idea.typst.typm.TypmProjectActivity"/>
        <platform.lsp.integrationProvider
                implementation="dev.thynanami.idea.typst.lsp.TypstLspServerSupportProvider"/>
        <psi.implicitReferenceProvider implementation="dev.thynanami.idea.typst.lsp.TypstLspSymbolProvider"
                                       order="last"/>
        <psi.declarationProvider implementation="dev.thynanami.idea.typst.lsp.TypstLspSymbolProvider"/>
        <searcher forClass="com.intellij.find.usages.api.UsageSearchParameters"
                  implementationClass="dev.thynanami.idea.typst.lsp.TypstLspUsageSearcher"/>
        <renameHandler implementation="dev.thynanami.idea.typst.lsp.TypstRenameHandler"/>
        <textmate.bundleProvider implementation="dev.thynanami.idea.typst.TypstTextMateBundleProvider"/>
        <colorSettingsPage implementation="dev.thynanami.idea.typst.config.TypstColorSettingsPage"/>
        <langCodeStyleSettingsProvider implementation="dev.thynanami.idea.typst.config.TypstCodeStyleSettingsProvider"/>
        <additionalTextAttributes scheme="Light" file="colorSchemes/TypstLight.xml"/>
        <additionalTextAttributes scheme="Dark" file="colorSchemes/TypstDark.xml"/>
        <notificationGroup id="Typst"
                           displayType="BALLOON"/>
        <editorHighlighterProvider
                filetype="Typst"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory
                language="Typst"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
        <editorHighlighterProvider
                filetype="Typst (Code Mode)"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateEditorHighlighterProvider"/>
        <lang.syntaxHighlighterFactory
                language="TypstCode"
                implementationClass="org.jetbrains.plugins.textmate.language.syntax.highlighting.TextMateSyntaxHighlighterFactory"/>
    </extensions>

    <applicationListeners>
        <listener class="dev.thynanami.idea.typst.lsp.TypstCodeStyleSettingsListener"
                  topic="com.intellij.psi.codeStyle.CodeStyleSettingsListener"/>
    </applicationListeners>
    <projectListeners>
        <listener class="dev.thynanami.idea.typst.lsp.TypstCodeStyleSettingsListener"
                  topic="com.intellij.psi.codeStyle.CodeStyleSettingsListener"/>
    </projectListeners>
</idea-plugin>
