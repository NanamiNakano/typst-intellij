<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>dev.thynanami.idea.typst</id>
    <name>Typst</name>
    <vendor>Nanami Nakano</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider
                implementation="dev.thynanami.idea.typst.languageserver.TypstLspServerSupportProvider"/>
        <notificationGroup id="Typst"
                           displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <fileEditorProvider implementation="dev.thynanami.idea.typst.editor.TypstEditorProvider"/>

        <fileType
                name="Typst"
                implementationClass="dev.thynanami.idea.typst.TypstFileType"
                fieldName="INSTANCE"
                language="Typst"
                extensions="typ"/>
        <applicationConfigurable instance="dev.thynanami.idea.typst.config.TypstSettingsConfigurable"
                                 displayName="Typst Settings"/>
    </extensions>
</idea-plugin>
